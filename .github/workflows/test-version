name: My Test Workflow

on:
  push:
    branches:
      - main

jobs:
  demo:
    runs-on: ubuntu-latest

    steps:
      - name: Generate version
        id: generate
        run: echo "tag=1.0.0" >> "$GITHUB_OUTPUT"

      - name: Show version
        run: echo "Tag is ${{ steps.generate.outputs.tag }}"
